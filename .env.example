# 复制为项目根目录 .env，并将文件权限设为 600。
# 不要把真实值提交到 Git 或粘贴到对话中。

# 北大树洞：从你自己的合法浏览器会话中取得；不会自动登录。
# PKUHOLE_TOKEN=
# PKUHOLE_UUID=  # 如会话使用设备 ID 则填写；不填时适配器不发送该 header
# PKUHOLE_XSRF_TOKEN=
# PKUHOLE_COOKIE_PKU_TOKEN=
# PKUHOLE_SESSION_COOKIE=

# PushPlus 用户 token；仅在 notify.provider = "pushplus" 时需要。
# PUSHPLUS_TOKEN=
